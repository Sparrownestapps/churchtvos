' Church TV OS for Roku: entry point. Creates the SceneGraph screen and keeps the channel alive.
sub main(args as dynamic)
    screen = CreateObject("roSGScreen")
    port = CreateObject("roMessagePort")
    screen.setMessagePort(port)
    ' roInput delivers deep links sent while the channel is already running (see supports_input_launch in the manifest).
    input = CreateObject("roInput")
    input.setMessagePort(port)
    scene = screen.CreateScene("MainScene")
    screen.show()
    if args <> invalid then scene.launchArgs = args
    ' Tells the Roku the channel is ready (certification requirement for channels that load content after launch).
    scene.signalBeacon("AppLaunchComplete")

    while true
        msg = wait(0, port)
        if type(msg) = "roSGScreenEvent" then
            if msg.isScreenClosed() then return
        else if type(msg) = "roInputEvent" then
            info = msg.getInfo()
            if info <> invalid then scene.launchArgs = info
        end if
    end while
end sub
